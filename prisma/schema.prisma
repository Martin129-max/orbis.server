generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Theme {
  system
  light
  dark
}

enum CommentableType {
  post
  thread
}

enum VotableType {
  thread
  comment
}

enum ReportCategory {
  bug
  idea
  other
}

enum ReportStatus {
  todo
  in_progress
  done
}

enum NotificationType {
  post_comment
  thread_comment
  comment_reply
  friend_request
  friend_accepted
  report_status
}

enum FriendshipStatus {
  pending
  accepted
}

model User {
  id                   Int            @id @default(autoincrement())
  email                String         @unique
  username             String         @unique
  name                 String?
  avatarUrl            String?
  password             String
  theme                Theme          @default(system)
  appearOffline        Boolean        @default(false)
  isAdmin              Boolean        @default(false)
  tourCompletedAt      DateTime?
  checklistDismissedAt DateTime?
  createdAt            DateTime       @default(now())
  ownedCommunities     Community[]
  memberships          Membership[]
  posts                Post[]
  sentFriendships      Friendship[]   @relation("FriendshipRequester")
  receivedFriendships  Friendship[]   @relation("FriendshipAddressee")
  threads              Thread[]
  comments             Comment[]
  votes                Vote[]
  reports              Report[]
  notifications        Notification[] @relation("NotificationRecipient")
  causedNotifications  Notification[] @relation("NotificationActor")
}

model Community {
  id            Int          @id @default(autoincrement())
  name          String
  iconUrl       String?
  coverUrl      String?
  backgroundUrl String?
  ownerId       Int
  isPublic      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  owner         User         @relation(fields: [ownerId], references: [id])
  memberships   Membership[]
  roles         Role[]
  posts         Post[]
  threads       Thread[]
  comments      Comment[]
  votes         Vote[]

  @@index([ownerId])
}

model Membership {
  userId      Int
  communityId Int
  nickname    String?
  position    Int              @default(0)
  joinedAt    DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  roles       MembershipRole[]

  @@id([userId, communityId])
  @@index([communityId])
}

model Role {
  id          Int              @id @default(autoincrement())
  communityId Int
  name        String
  permissions BigInt           @default(0)
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members     MembershipRole[]

  @@unique([id, communityId])
  @@index([communityId])
}

model MembershipRole {
  userId      Int
  communityId Int
  roleId      Int
  membership  Membership @relation(fields: [userId, communityId], references: [userId, communityId], onDelete: Cascade)
  role        Role       @relation(fields: [roleId, communityId], references: [id, communityId], onDelete: Cascade)

  @@id([userId, communityId, roleId])
  @@index([roleId])
}

model Post {
  id           Int       @id @default(autoincrement())
  communityId  Int
  authorId     Int
  content      String
  commentCount Int       @default(0)
  createdAt    DateTime  @default(now())
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author       User      @relation(fields: [authorId], references: [id])

  @@index([communityId, createdAt(sort: Desc)])
}

model Friendship {
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@id([requesterId, addresseeId])
  @@index([addresseeId])
}

model Thread {
  id           Int       @id @default(autoincrement())
  communityId  Int
  authorId     Int
  title        String
  content      String    @default("")
  score        Int       @default(0)
  commentCount Int       @default(0)
  createdAt    DateTime  @default(now())
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author       User      @relation(fields: [authorId], references: [id])

  @@index([communityId, createdAt(sort: Desc)])
  @@index([communityId, score])
}

model Comment {
  id              Int             @id @default(autoincrement())
  communityId     Int
  commentableType CommentableType
  commentableId   Int
  parentId        Int?
  authorId        Int
  content         String
  score           Int             @default(0)
  createdAt       DateTime        @default(now())
  community       Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author          User            @relation(fields: [authorId], references: [id])
  parent          Comment?        @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         Comment[]       @relation("CommentReplies")

  @@index([commentableType, commentableId, createdAt])
  @@index([parentId])
}

model Vote {
  userId      Int
  votableType VotableType
  votableId   Int
  communityId Int
  value       Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([userId, votableType, votableId])
  @@index([votableType, votableId])
}

model Report {
  id        Int            @id @default(autoincrement())
  authorId  Int
  category  ReportCategory
  status    ReportStatus   @default(todo)
  message   String
  pageUrl   String?
  createdAt DateTime       @default(now())
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  actorId   Int?
  type      NotificationType
  message   String
  link      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
}
