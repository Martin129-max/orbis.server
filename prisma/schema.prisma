generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Theme {
  system
  light
  dark
}

enum FriendshipStatus {
  pending
  accepted
}

model User {
  id                  Int          @id @default(autoincrement())
  email               String       @unique
  name                String?
  password            String
  theme               Theme        @default(system)
  appearOffline       Boolean      @default(false)
  createdAt           DateTime     @default(now())
  ownedCommunities    Community[]
  memberships         Membership[]
  posts               Post[]
  sentFriendships     Friendship[] @relation("FriendshipRequester")
  receivedFriendships Friendship[] @relation("FriendshipAddressee")
}

model Community {
  id          Int          @id @default(autoincrement())
  name        String
  ownerId     Int
  isPublic    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  owner       User         @relation(fields: [ownerId], references: [id])
  memberships Membership[]
  roles       Role[]
  posts       Post[]

  @@index([ownerId])
}

model Membership {
  userId      Int
  communityId Int
  nickname    String?
  position    Int              @default(0)
  joinedAt    DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  roles       MembershipRole[]

  @@id([userId, communityId])
  @@index([communityId])
}

model Role {
  id          Int              @id @default(autoincrement())
  communityId Int
  name        String
  permissions BigInt           @default(0)
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members     MembershipRole[]

  @@unique([id, communityId])
  @@index([communityId])
}

model MembershipRole {
  userId      Int
  communityId Int
  roleId      Int
  membership  Membership @relation(fields: [userId, communityId], references: [userId, communityId], onDelete: Cascade)
  role        Role       @relation(fields: [roleId, communityId], references: [id, communityId], onDelete: Cascade)

  @@id([userId, communityId, roleId])
  @@index([roleId])
}

model Post {
  id          Int       @id @default(autoincrement())
  communityId Int
  authorId    Int
  content     String
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id])

  @@index([communityId, createdAt(sort: Desc)])
}

model Friendship {
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@id([requesterId, addresseeId])
  @@index([addresseeId])
}
