enum CommentableType {
  post
  thread
  activity
}

enum LikeableType {
  post
  activity
}

enum VotableType {
  thread
  comment
}

model Post {
  id            Int        @id @default(autoincrement())
  communityId   Int?
  wallUserId    Int?
  mediaType     MediaType?
  mediaSourceId String?
  authorId      Int
  content       String
  linkUrl       String?
  commentCount  Int        @default(0)
  likeCount     Int        @default(0)
  hiddenAt      DateTime?
  createdAt     DateTime   @default(now())
  community     Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  wallUser      User?      @relation("WallPosts", fields: [wallUserId], references: [id], onDelete: Cascade)
  author        User       @relation(fields: [authorId], references: [id])

  @@index([communityId, createdAt(sort: Desc)])
  @@index([wallUserId, createdAt(sort: Desc)])
  @@index([mediaType, mediaSourceId, createdAt(sort: Desc)])
}

model Thread {
  id           Int       @id @default(autoincrement())
  communityId  Int
  authorId     Int
  title        String
  content      String    @default("")
  linkUrl      String?
  score        Int       @default(1)
  commentCount Int       @default(0)
  hiddenAt     DateTime?
  createdAt    DateTime  @default(now())
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author       User      @relation(fields: [authorId], references: [id])

  @@index([communityId, createdAt(sort: Desc)])
  @@index([communityId, score])
}

model Comment {
  id              Int             @id @default(autoincrement())
  communityId     Int?
  commentableType CommentableType
  commentableId   Int
  parentId        Int?
  authorId        Int
  content         String
  linkUrl         String?
  score           Int             @default(1)
  hiddenAt        DateTime?
  createdAt       DateTime        @default(now())
  community       Community?      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author          User            @relation(fields: [authorId], references: [id])
  parent          Comment?        @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         Comment[]       @relation("CommentReplies")

  @@index([commentableType, commentableId, createdAt])
  @@index([parentId])
}

model Vote {
  userId      Int
  votableType VotableType
  votableId   Int
  communityId Int?
  value       Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community?  @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([userId, votableType, votableId])
  @@index([votableType, votableId])
}

model Like {
  userId       Int
  likeableType LikeableType
  likeableId   Int
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, likeableType, likeableId])
  @@index([likeableType, likeableId])
}
