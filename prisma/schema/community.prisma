model Community {
  id            Int          @id @default(autoincrement())
  name          String
  description   String?
  iconUrl       String?
  coverUrl      String?
  backgroundUrl String?
  twitchUserId  String?
  twitchLogin   String?
  ownerId       Int
  isPublic      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  owner         User         @relation(fields: [ownerId], references: [id])
  memberships   Membership[]
  roles         Role[]
  posts         Post[]
  threads       Thread[]
  comments      Comment[]
  votes         Vote[]
  invites       Invite[]

  @@index([ownerId])
}

model Membership {
  userId      Int
  communityId Int
  nickname    String?
  position    Int              @default(0)
  folderId    Int?
  joinedAt    DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  folder      RailFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  roles       MembershipRole[]

  @@id([userId, communityId])
  @@index([communityId])
  @@index([folderId])
}

model RailFolder {
  id          Int          @id @default(autoincrement())
  userId      Int
  name        String?
  color       String?
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([userId])
}

model Role {
  id          Int              @id @default(autoincrement())
  communityId Int
  name        String
  permissions BigInt           @default(0)
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members     MembershipRole[]

  @@unique([id, communityId])
  @@index([communityId])
}

model MembershipRole {
  userId      Int
  communityId Int
  roleId      Int
  membership  Membership @relation(fields: [userId, communityId], references: [userId, communityId], onDelete: Cascade)
  role        Role       @relation(fields: [roleId, communityId], references: [id, communityId], onDelete: Cascade)

  @@id([userId, communityId, roleId])
  @@index([roleId])
}

model Invite {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  communityId Int
  creatorId   Int
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime?
  permanent   Boolean   @default(false)
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  creator     User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([creatorId])
}
