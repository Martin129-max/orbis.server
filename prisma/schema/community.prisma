model Community {
  id            Int          @id @default(autoincrement())
  name          String
  iconUrl       String?
  coverUrl      String?
  backgroundUrl String?
  ownerId       Int
  isPublic      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  owner         User         @relation(fields: [ownerId], references: [id])
  memberships   Membership[]
  roles         Role[]
  posts         Post[]
  threads       Thread[]
  comments      Comment[]
  votes         Vote[]

  @@index([ownerId])
}

model Membership {
  userId      Int
  communityId Int
  nickname    String?
  position    Int              @default(0)
  joinedAt    DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  roles       MembershipRole[]

  @@id([userId, communityId])
  @@index([communityId])
}

model Role {
  id          Int              @id @default(autoincrement())
  communityId Int
  name        String
  permissions BigInt           @default(0)
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members     MembershipRole[]

  @@unique([id, communityId])
  @@index([communityId])
}

model MembershipRole {
  userId      Int
  communityId Int
  roleId      Int
  membership  Membership @relation(fields: [userId, communityId], references: [userId, communityId], onDelete: Cascade)
  role        Role       @relation(fields: [roleId, communityId], references: [id, communityId], onDelete: Cascade)

  @@id([userId, communityId, roleId])
  @@index([roleId])
}
